-- right-hand status pill: notification bell (left-click toggles do-not-disturb, right-click clears the unread dot); hspace centres the glyph
-- one of five floating pills (pill-*.rc), centred on the hanging islands; picom rounds them via wmName
Config
  { font            = "JetBrainsMono Nerd Font Bold 10"
  , additionalFonts = [ "JetBrainsMono Nerd Font 10" ]
  , bgColor         = "#1d2021"
  , fgColor         = "#a89984"
  , alpha           = 200
  , position        = Static { xpos = 1858, ypos = 3, width = 24, height = 24 }
  , textOffset      = 0
  , wmName          = "xmobar-pill"
  , border          = NoBorder
  , lowerOnStart    = True
  , allDesktops     = True
  , persistent      = True
  , commands        = [ Run Com "/home/sabir/.config/xmonad/scripts/bar/dnd.sh" [] "dnd" 10 ]
  , sepChar         = "%"
  , alignSep        = "}{"
  , template        = "<hspace=7/><action=`dunstctl set-paused toggle` button=1><action=`/home/sabir/.config/xmonad/scripts/bar/bell-seen.sh` button=3>%dnd%</action></action>}{"
  }
