-- right-hand status pill: power menu; hspace centres the glyph
-- one of five floating pills (pill-*.rc), centred on the hanging islands; picom rounds them via wmName
Config
  { font            = "JetBrainsMono Nerd Font Bold 10"
  , additionalFonts = [ "JetBrainsMono Nerd Font 10" ]
  , bgColor         = "#1d2021"
  , fgColor         = "#a89984"
  , alpha           = 200
  , position        = Static { xpos = 1888, ypos = 3, width = 24, height = 24 }
  , textOffset      = 0
  , wmName          = "xmobar-pill"
  , border          = NoBorder
  , lowerOnStart    = True
  , allDesktops     = True
  , persistent      = True
  , commands        = [ Run Com "true" [] "x" 0 ]
  , sepChar         = "%"
  , alignSep        = "}{"
  , template        = "<hspace=8/><action=`xdotool key super+shift+e`><fc=#d65d0e>󰐥</fc></action>}{"
  }
