-- left island: workspaces + layout
Config
  { font         = "JetBrainsMono Nerd Font Bold 10"
  , bgColor      = "#1d2021"
  , fgColor      = "#a89984"
  , alpha        = 200
  , position     = Static { xpos = 8, ypos = -8, width = 224, height = 38 }
  , textOffset   = 4  -- top 8px is off-screen; keeps text centred in the visible 30px
  , border       = NoBorder
  , lowerOnStart = True
  , allDesktops  = True
  , persistent   = True
  , commands     = [ Run UnsafeXMonadLog ]
  , sepChar      = "%"
  , alignSep     = "}{"
  , template     = "}   %UnsafeXMonadLog%   {"
  }
